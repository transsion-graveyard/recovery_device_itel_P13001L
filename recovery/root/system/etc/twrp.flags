/boot                   emmc          /dev/block/by-name/boot                     flags=display=boot;slotselect;backup;flashimg
/vendor_boot            emmc          /dev/block/by-name/vendor_boot              flags=display=vendor_boot;slotselect;backup;flashimg
/vbmeta                 emmc          /dev/block/by-name/vbmeta                   flags=display=vbmeta;slotselect;backup
/vbmeta_system          emmc          /dev/block/by-name/vbmeta_system            flags=display=vbmeta_system;slotselect
/vbmeta_vendor          emmc          /dev/block/by-name/vbmeta_vendor            flags=display=vbmeta_vendor;slotselect
/dtbo                   emmc          /dev/block/by-name/dtbo                     flags=display=dtbo;slotselect

/metadata               ext4          /dev/block/by-name/metadata                 flags=display=metadata;backup
/misc                   emmc          /dev/block/by-name/misc                     flags=display=misc
/nvcfg                  emmc          /dev/block/by-name/nvcfg                    flags=display=nvcfg;backup
/nvdata                 emmc          /dev/block/by-name/nvdata                   flags=display=nvdata;backup
/nvram                  emmc          /dev/block/by-name/nvram                    flags=display=nvram;backup
/persist                emmc          /dev/block/by-name/persist                  flags=display=persist;backup
/persistent             emmc          /dev/block/by-name/frp                      flags=display=persistent;backup
/protect_f              emmc          /dev/block/by-name/protect1                 flags=display=protect_f;backup
/protect_s              emmc          /dev/block/by-name/protect2                 flags=display=protect_s;backup

/expdb                  emmc          /dev/block/by-name/expdb                    flags=display=expdb
/logo                   emmc          /dev/block/by-name/logo                     flags=display=logo;slotselect;backup
/otp                    emmc          /dev/block/by-name/otp                      flags=display=otp
/seccfg                 emmc          /dev/block/by-name/seccfg                   flags=display=seccfg
/spmfw                  emmc          /dev/block/by-name/spmfw                    flags=display=spmfw;slotselect
/tee1                   emmc          /dev/block/by-name/tee1                     flags=display=tee1
/tee2                   emmc          /dev/block/by-name/tee2                     flags=display=tee2

/system_image           emmc          /dev/block/bootdevice/by-name/system        flags=display="System Image";flashimg
/vendor_image           emmc          /dev/block/bootdevice/by-name/vendor        flags=display="Vendor Image"
/product_image          emmc          /dev/block/bootdevice/by-name/product       flags=display="Product Image"
/system_ext_image       emmc          /dev/block/bootdevice/by-name/system_ext    flags=display="System_EXT Image"
/vendor_dlkm_image      emmc          /dev/block/bootdevice/by-name/vendor_dlkm   flags=display="Vendor DLKM Image"
/odm_dlkm_image         emmc          /dev/block/bootdevice/by-name/odm_dlkm      flags=display="ODM DLKM Image"

/external_sd            auto          /dev/block/mmcblk1p1                        /dev/block/mmcblk0p1    flags=display="Micro SD Card";storage;wipeingui;removable;backup=0
/usb_otg                auto          /dev/block/sdd1                             /dev/block/sdd          flags=display="USB-OTG";storage;wipeingui;removable;backup=0
