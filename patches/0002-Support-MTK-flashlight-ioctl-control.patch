+namespace {
+struct mtk_flashlight_arg {
+	int type;
+	int ct;
+	int arg;
+};
+
+constexpr unsigned long MTK_FLASH_IOC_SET_TIMEOUT = 0x80045364UL;
+constexpr unsigned long MTK_FLASH_IOC_SET_DUTY = 0x8004536eUL;
+constexpr unsigned long MTK_FLASH_IOC_SET_ONOFF = 0x80045373UL;
+constexpr int MTK_FLASH_TYPE_MAIN = 1;
+constexpr int MTK_FLASH_CT_MAIN = 1;
+constexpr int MTK_FLASH_TORCH_DUTY = 1;
+constexpr int MTK_FLASH_TIMEOUT_MS = 600000;
+
+static int mtk_flashlight_ioctl(int fd, unsigned long cmd, int arg)
+{
+	mtk_flashlight_arg flash_arg;
+	flash_arg.type = MTK_FLASH_TYPE_MAIN;
+	flash_arg.ct = MTK_FLASH_CT_MAIN;
+	flash_arg.arg = arg;
+	return ioctl(fd, cmd, &flash_arg);
+}
+
+static bool mtk_flashlight_set(bool enable)
+{
+	int fd = open("/dev/flashlight", O_RDWR);
+	if (fd < 0)
+		return false;
+
+	bool ok;
+	if (enable) {
+		ok = mtk_flashlight_ioctl(fd, MTK_FLASH_IOC_SET_TIMEOUT, MTK_FLASH_TIMEOUT_MS) == 0 &&
+		     mtk_flashlight_ioctl(fd, MTK_FLASH_IOC_SET_DUTY, MTK_FLASH_TORCH_DUTY) == 0 &&
+		     mtk_flashlight_ioctl(fd, MTK_FLASH_IOC_SET_ONOFF, 1) == 0;
+		if (!ok)
+			mtk_flashlight_ioctl(fd, MTK_FLASH_IOC_SET_ONOFF, 0);
+	} else {
+		ok = mtk_flashlight_ioctl(fd, MTK_FLASH_IOC_SET_ONOFF, 0) == 0;
+	}
+
+	close(fd);
+	return ok;
+}
